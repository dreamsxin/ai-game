{
  "name": "ai-game-collection",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "wuqizi",
    "xiaoyuanmian"
  ],
  "scripts": {
    "dev": "npm run dev --workspace wuqizi",
    "dev:wuqizi": "npm run dev --workspace wuqizi",
    "dev:xiaoyuanmian": "npm run dev --workspace xiaoyuanmian",
    "build": "npm run build --workspaces --if-present",
    "build:wuqizi": "npm run build --workspace wuqizi",
    "build:xiaoyuanmian": "npm run build --workspace xiaoyuanmian",
    "start": "npm run start --workspace wuqizi",
    "start:xiaoyuanmian": "npm run start --workspace xiaoyuanmian",
    "test": "npm test --workspaces --if-present",
    "test:wuqizi": "npm test --workspace wuqizi",
    "test:xiaoyuanmian": "npm test --workspace xiaoyuanmian"
  }
}
